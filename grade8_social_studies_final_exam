
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grade 8 ESS Exam</title>
<style>
:root {
 --bg:#090d18;--panel:#111827;--line:#26344a;
 --text:#edf2fb;--muted:#9aa9bf;
 --accent:#8b7cff;--good:#36c98f;--bad:#ff6b7a;
}
*{box-sizing:border-box}
body{
 margin:0;padding:15px;background:var(--bg);color:var(--text);
 font:15px/1.55 Arial,sans-serif;
}
.container{max-width:950px;margin:20px auto}
.card{
 background:#111827;border:1px solid var(--line);
 border-radius:18px;padding:25px;margin-bottom:16px;
}
h1{font-size:clamp(26px,5vw,40px);margin:10px 0}
h2{font-size:22px;line-height:1.4}
.muted{color:var(--muted)}
.eyebrow{color:#a99fff;font-size:12px;letter-spacing:2px;font-weight:bold}
.stats{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
.stat{background:#0d1626;padding:12px 16px;border-radius:12px;min-width:110px}
.stat b{display:block;font-size:20px}
.stat span{font-size:11px;color:var(--muted)}
button{
 cursor:pointer;border:1px solid var(--line);border-radius:11px;
 padding:12px 17px;background:#1a2940;color:white;font-size:14px;
 font-weight:bold;
}
button:hover{filter:brightness(1.2)}
.primary{background:linear-gradient(110deg,#796aff,#527ff2);border:0}
button:disabled{opacity:.35;cursor:not-allowed}
.hidden{display:none!important}
.top{display:flex;justify-content:space-between;gap:12px;align-items:center}
.timer{font-weight:bold;font-size:18px;font-variant-numeric:tabular-nums}
.progress{height:8px;background:#26344a;border-radius:10px;margin:15px 0;overflow:hidden}
.bar{height:100%;width:0;background:linear-gradient(90deg,#8b7cff,#5f8cff)}
.tag{background:#28244a;color:#b8afff;padding:5px 10px;border-radius:20px;font-size:12px}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.answer{
 display:flex;align-items:flex-start;gap:12px;text-align:left;
 min-height:58px;background:#111d30;padding:14px;
}
.answer.selected{border-color:var(--accent);background:#29254d}
.letter{
 background:#26344a;border-radius:7px;padding:3px 9px;
 font-size:12px;flex-shrink:0;
}
.answer.selected .letter{background:var(--accent)}
.controls{display:flex;justify-content:space-between;gap:10px;margin-top:22px;align-items:center}
.navigator{display:grid;grid-template-columns:repeat(10,1fr);gap:7px;margin-top:15px}
.navigator button{padding:8px 0;font-size:12px}
.navigator button.done{background:#29254d;border-color:#7468e8}
.navigator button.current{outline:2px solid #a99fff}
.score{font-size:48px;font-weight:900;margin:10px 0}
.review-item{padding:15px 0;border-bottom:1px solid var(--line)}
.correct{color:var(--good)}
.incorrect{color:var(--bad)}
@media(max-width:650px){
 body{padding:8px}
 .container{margin:8px auto}
 .card{padding:16px}
 .answers{grid-template-columns:1fr}
 .navigator{grid-template-columns:repeat(5,1fr)}
 .controls button{padding:10px}
 .stat{min-width:calc(33.33% - 5px);padding:9px}
}
</style>
</head>
<body>
<div class="container">

<div class="top">
 <div class="eyebrow">SUMMIT • GRADE 8 • ESS</div>
 <span class="tag">REVISION EXAM</span>
</div>

<section class="card" id="intro">
 <div class="eyebrow">END OF UNIT ASSESSMENT</div>
 <h1>Renaissance & Protestant Reformation</h1>
 <p class="muted">Test your knowledge of the Renaissance, humanism, art, the Medici family, the printing press and the Protestant Reformation.</p>

 <div class="stats">
  <div class="stat"><b>50</b><span>QUESTIONS</span></div>
  <div class="stat"><b>40 + 10</b><span>QUESTION TYPES</span></div>
  <div class="stat"><b>45 min</b><span>TIME LIMIT</span></div>
 </div>

 <button class="primary" onclick="startExam()">Start exam</button>
</section>

<section class="card hidden" id="exam">
 <div class="top">
  <div>
   <div class="eyebrow">YOUR EXAM</div>
   <span class="muted" id="questionCount"></span>
  </div>
  <div class="timer" id="timer">45:00</div>
 </div>

 <div class="progress"><div class="bar" id="progress"></div></div>

 <div class="top">
  <span id="number" class="muted"></span>
  <span id="category" class="tag"></span>
 </div>

 <h2 id="question"></h2>
 <div class="answers" id="answers"></div>

 <div class="controls">
  <button id="previous" onclick="move(-1)">← Previous</button>
  <span class="muted" id="answered"></span>
  <button class="primary" id="next" onclick="move(1)">Next →</button>
 </div>

 <div class="top" style="margin-top:25px">
  <span class="muted">QUESTION NAVIGATOR</span>
  <button onclick="submitExam()">Submit exam</button>
 </div>
 <div class="navigator" id="navigator"></div>
</section>

<section class="card hidden" id="results"></section>
</div>

<script>
const questions = [
["Renaissance","What does the word 'Renaissance' mean?",["Revolution","Rebirth","Reform","Discovery"],1],
["Renaissance","Where did the Renaissance begin?",["Germany","Italy","France","England"],1],
["Humanism","Humanism focused on the study of...",["Military strategy","Classical Greek and Roman texts","Architecture only","Trade routes"],1],
["Florence","Which city became a leading Renaissance centre?",["Paris","Madrid","Florence","Vienna"],2],
["Medici Family","Why was the Medici family important?",["They funded artists and scholars","They invented the printing press","They started Lutheranism","They ruled England"],0],
["Art","Who painted the Mona Lisa?",["Raphael","Michelangelo","Leonardo da Vinci","Donatello"],2],
["Art","What artistic technique creates depth on a flat surface?",["Patronage","Perspective","Humanism","Realism"],1],
["Printing Press","Who developed the European movable-type printing press?",["Martin Luther","Erasmus","Johannes Gutenberg","Jan van Eyck"],2],
["Printing Press","A major effect of the printing press was that...",["Books became more expensive","Ideas spread more quickly","People stopped reading","Trade declined"],1],
["Northern Renaissance","Who was a leading Northern Renaissance humanist?",["Leonardo da Vinci","Erasmus","Michelangelo","Raphael"],1],
["Northern Renaissance","Christian humanism aimed to...",["Improve understanding of Christianity through study","Replace Christianity","Ban books","Create new governments"],0],
["Art","Which Northern Renaissance artist painted the Arnolfini Portrait?",["Raphael","Jan van Eyck","Donatello","Michelangelo"],1],
["Leonardo da Vinci","Why is Leonardo called a polymath?",["He ruled Florence","He excelled in many fields","He invented books","He became Pope"],1],
["Patronage","What is patronage?",["Military service","Financial support for artists and scholars","Religious taxes","Trade agreements"],1],
["Humanism","Who is often called the father of humanism?",["Martin Luther","Johannes Gutenberg","Francesco Petrarch","Erasmus"],2],
["Printing Press","The Gutenberg Bible was completed around...",["1255","1355","1455","1555"],2],
["Reformation","The Protestant Reformation began in...",["1517","1436","1600","1492"],0],
["Martin Luther","Martin Luther was a...",["King","Pope","German monk and professor","Artist"],2],
["Indulgences","An indulgence was connected to...",["Military service","Reducing punishment for sins","Trade licences","Education"],1],
["95 Theses","Martin Luther's 95 Theses mainly criticized...",["Humanism","Printing","Indulgence preaching","Banking"],2],
["Martin Luther","What did Martin Luther write in 1517?",["The Prince","95 Theses","Utopia","Gutenberg Bible"],1],
["95 Theses","The 95 Theses mainly challenged...",["Church architecture","The sale of indulgences","Humanism","The Renaissance"],1],
["Printing Press","Why did Luther's ideas spread quickly across Europe?",["Because kings ordered everyone to read them","Because of the printing press","Because of television","Because of universities only"],1],
["Diet of Worms","At the Diet of Worms in 1521, Martin Luther...",["Became Pope","Agreed to remove his writings","Refused to take back his writings","Moved to England"],2],
["Frederick the Wise","Who protected Martin Luther after the Diet of Worms?",["Charles V","Henry VIII","Erasmus","Frederick the Wise"],3],
["Protestant Reformation","The Protestant Reformation was a movement that...",["Supported indulgence sales","Challenged practices in the Catholic Church","Promoted feudalism","Ended printing"],1],
["Lutheranism","Lutheranism is named after...",["Leonardo da Vinci","Martin Luther","John Calvin","Erasmus"],1],
["Calvinism","Which individual is most closely associated with Calvinism?",["John Calvin","Henry VIII","Martin Luther","Petrarch"],0],
["Anglicanism","Anglicanism developed in...",["Germany","France","England","Italy"],2],
["Henry VIII","Who became head of the Church of England?",["Martin Luther","John Calvin","Henry VIII","Charles V"],2],
["Catholic Church","Who was the highest authority in the Catholic Church?",["The King","The Pope","The Archbishop of Mainz","The Emperor"],1],
["Authority","According to many Protestants, the highest religious authority was...",["The King","Tradition","The Bible","The Pope"],2],
["Bible","Many Protestants wanted the Bible translated into...",["Latin only","Ancient Greek only","Local languages","No languages"],2],
["Peace of Augsburg","The Peace of Augsburg was signed in...",["1455","1517","1555","1648"],2],
["Peace of Augsburg","The Peace of Augsburg allowed rulers to choose between...",["Anglicanism and Islam","Catholicism and Lutheranism","Humanism and Calvinism","Orthodoxy and Anglicanism"],1],
["Printing Press","Which invention helped both Renaissance and Reformation ideas spread?",["Compass","Printing Press","Steam Engine","Telescope"],1],
["Consequences","One major result of the Reformation was...",["Religious unity across Europe","The end of Christianity","The growth of different Christian denominations","The end of education"],2],
["Consequences","Which war is often linked to religious divisions after the Reformation?",["Hundred Years' War","Thirty Years' War","Peloponnesian War","Crimean War"],1],
["Historical Thinking","Which factor helped spread Reformation ideas the MOST?",["Printing technology","Castles","Feudalism","Longbows"],0],
["Cause and Effect","What was a direct effect of criticisms of indulgences?",["The beginning of the Protestant Reformation","The fall of Florence","The invention of humanism","The rise of the Medici Bank"],0],
["Fill in the Blank","The Renaissance began in ________.",["France","Germany","Italy","England"],2],
["Fill in the Blank","The wealthy family that supported many artists in Florence was the ________ family.",["Medici","Tudor","Calvin","Borgia"],0],
["Fill in the Blank","Johannes Gutenberg developed the ________ press.",["steam","printing","oil","wine"],1],
["Fill in the Blank","Martin ________ wrote the 95 Theses.",["Calvin","Henry","Luther","Erasmus"],2],
["Fill in the Blank","The document written by Martin Luther was called the 95 ________.",["Arguments","Rules","Articles","Theses"],3],
["Fill in the Blank","A practice criticized during the Reformation was the sale of ________.",["Taxes","Books","Indulgences","Land"],2],
["Fill in the Blank","The Protestant ________ challenged practices within the Catholic Church.",["Movement","Reformation","Empire","Revival"],1],
["Fill in the Blank","The leading Northern Renaissance humanist was ________.",["Michelangelo","Raphael","Erasmus","Donatello"],2],
["Fill in the Blank","The Peace of ________ was signed in 1555.",["Westphalia","Rome","Worms","Augsburg"],3],
["Fill in the Blank","A person who financially supports artists is called a ________.",["Scholar","Patron","Monk","Merchant"],1]
];

let order=[],answers={},current=0,time=45*60,clock=null,finished=false;

function shuffle(array){
 let a=[...array];
 for(let i=a.length-1;i>0;i--){
  let j=Math.floor(Math.random()*(i+1));
  [a[i],a[j]]=[a[j],a[i]];
 }
 return a;
}

function startExam(){
 order=shuffle(questions.map((_,i)=>i));
 document.getElementById("intro").classList.add("hidden");
 document.getElementById("exam").classList.remove("hidden");
 buildNavigator();
 renderQuestion();
 clock=setInterval(()=>{
  time--;
  let m=Math.floor(time/60),s=time%60;
  document.getElementById("timer").textContent=
   `${m}:${String(s).padStart(2,"0")}`;
  if(time<=0)submitExam(true);
 },1000);
}

function buildNavigator(){
 const nav=document.getElementById("navigator");
 nav.innerHTML="";
 order.forEach((_,i)=>{
  const b=document.createElement("button");
  b.textContent=i+1;
  b.onclick=()=>{current=i;renderQuestion()};
  b.id="nav"+i;
  nav.appendChild(b);
 });
}

function renderQuestion(){
 const q=questions[order[current]];
 document.getElementById("number").textContent=`QUESTION ${current+1}`;
 document.getElementById("questionCount").textContent=
  `Question ${current+1} of 50`;
 document.getElementById("category").textContent=q[0];
 document.getElementById("question").textContent=q[1];
 document.getElementById("progress").style.width=
  ((current+1)/50*100)+"%";

 const answersBox=document.getElementById("answers");
 answersBox.innerHTML="";
 if(!q.displayOrder)q.displayOrder=shuffle([0,1,2,3]);

 q.displayOrder.forEach((choice,i)=>{
  const b=document.createElement("button");
  b.className="answer"+(answers[order[current]]===choice?" selected":"");
  const letter=document.createElement("span");
  letter.className="letter";
  letter.textContent="ABCD"[i];
  const text=document.createElement("span");
  text.textContent=q[2][choice];
  b.append(letter,text);
  b.onclick=()=>{answers[order[current]]=choice;renderQuestion()};
  answersBox.appendChild(b);
 });

 document.getElementById("previous").disabled=current===0;
 document.getElementById("next").textContent=
  current===49?"Finish →":"Next →";
 document.getElementById("answered").textContent=
  `${Object.keys(answers).length} / 50 answered`;

 order.forEach((_,i)=>{
  const b=document.getElementById("nav"+i);
  b.classList.toggle("done",answers[order[i]]!==undefined);
  b.classList.toggle("current",i===current);
 });
}

function move(direction){
 if(direction===-1&&current>0)current--;
 if(direction===1&&current<49)current++;
 else if(direction===1&&current===49){
  if(confirm("Submit your exam now?"))submitExam();
  return;
 }
 renderQuestion();
}

function submitExam(auto=false){
 if(finished)return;
 const unanswered=50-Object.keys(answers).length;
 if(!auto&&!confirm(unanswered?
  `You have ${unanswered} unanswered questions. Submit anyway?`:
  "Are you sure you want to submit your exam?"))return;

 finished=true;
 clearInterval(clock);
 let score=0;
 questions.forEach((q,i)=>{if(answers[i]===q[3])score++});
 const percent=Math.round(score/50*100);
 document.getElementById("exam").classList.add("hidden");
 const result=document.getElementById("results");
 result.classList.remove("hidden");
 result.innerHTML=`
  <div class="eyebrow">EXAM COMPLETED</div>
  <h1>Your results</h1>
  <div class="score">${score} / 50</div>
  <p class="muted">${percent}% correct</p>
  <div class="progress"><div class="bar" style="width:${percent}%"></div></div>
  <div class="stats">
   <div class="stat"><b>${score}</b><span>CORRECT</span></div>
   <div class="stat"><b>${50-score}</b><span>INCORRECT</span></div>
   <div class="stat"><b>${Object.keys(answers).length}</b><span>ANSWERED</span></div>
  </div>
  <button class="primary" id="reviewButton">Review answers</button>
  <button onclick="location.reload()">Retake exam</button>
  <div id="review" class="hidden" style="margin-top:20px"></div>
 `;
 document.getElementById("reviewButton").onclick=showReview;
}

function showReview(){
 const box=document.getElementById("review");
 box.classList.remove("hidden");
 box.innerHTML="<h2>Answer review</h2>";
 order.forEach((index,pos)=>{
  const q=questions[index];
  const chosen=answers[index];
  const correct=chosen===q[3];
  const item=document.createElement("div");
  item.className="review-item";
  const status=document.createElement("div");
  status.className=correct?"correct":"incorrect";
  status.textContent=`${pos+1}. ${correct?"Correct":"Incorrect"}`;
  const question=document.createElement("p");
  question.textContent=q[1];
  const your=document.createElement("p");
  your.className="muted";
  your.textContent="Your answer: "+(chosen===undefined?"Not answered":q[2][chosen]);
  const answer=document.createElement("p");
  answer.className="correct";
  answer.textContent="Correct answer: "+q[2][q[3]];
  item.append(status,question,your,answer);
  box.appendChild(item);
 });
}
</script>
</body>
</html>
